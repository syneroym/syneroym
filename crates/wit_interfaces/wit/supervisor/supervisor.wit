package syneroym:supervisor;

interface supervisor {
    /// Submit or replace desired state for an app instance. The plan is
    /// already compiled, with artifacts inlined and member masters
    /// substituted -- the supervisor holds no catalog and never reads a
    /// manifest.
    record submission {
        app-instance-id: string,
        /// JSON `DeploymentPlan`.
        plan-json: string,
        /// JSON alias -> {did, api-url, ucan}.
        inventory-json: string,
        /// The generation this submission writes at. Minted by `adopt`;
        /// 0 for a first submission of an unmanaged instance.
        generation: u64,
    }

    /// One minted member master, returned by `submit` so an operator can
    /// record the DID and back it up -- mint-in-place means the operator
    /// holds nothing until they ask (`export-master`).
    record minted-master {
        service-name: string,
        master-did: string,
        /// The name `export-master`/`import-master` take -- not
        /// `service-name`: the vault keys on `member-<app-instance-id>#
        /// <service-name>-<index>`, so an operator who backs up under the
        /// bare logical name gets "no master named '<service-name>' in
        /// this vault" (S1, Slice A5b review).
        vault-name: string,
        /// This member's ordinal (M05A A5e). `submit` returns N rows per
        /// scaled service that are otherwise identical -- `service-name`
        /// alone cannot distinguish them, only `vault-name` can, and an
        /// operator should not have to parse it back out of that.
        member-index: u32,
    }

    record submit-result {
        masters: list<minted-master>,
    }

    variant managed-state { applying, active, degraded, paused, retired, superseded }

    record managed-service {
        /// The member's full `MemberRef` display string (M05A A5e):
        /// `<app-instance-id>/<service-name>#<index>`. Two members of one
        /// scaled service report two distinct rows here.
        logical-ref: string,
        service-id: string,
        substrate-alias: string,
        substrate-did: string,
        /// Mirrors `sdk::health::Signal`'s discriminant as a string:
        /// "healthy" / "substrate-unreachable" / "instance-not-running" /
        /// "probe-failing" / "unknown" / "not-deployed".
        signal: string,
        detail: string,
        restart-attempts: u32,
    }

    /// Per dependent, per declared dependency: what the supervisor last
    /// wrote versus what the hosting substrate reports serving *for that
    /// dependent*. Equal epochs mean converged.
    record binding-convergence {
        /// The dependent member's `MemberRef` display string (M05A A5e):
        /// each member of a scaled dependent holds its own epoch, and its
        /// own binding-write history, so this reports one row per member.
        dependent-logical-ref: string,
        dependency-name: string,
        written-epoch: u64,
        observed-epoch: option<u64>,
        converged: bool,
    }

    record instance-status {
        app-instance-id: string,
        state: managed-state,
        generation: u64,
        supervisor-did: string,
        last-reconciled-at: option<u64>,
        services: list<managed-service>,
        bindings: list<binding-convergence>,
        /// Delivery is best-effort synchronous. Said here rather than
        /// implied, so an operator reading a converged status is not
        /// reading a guarantee this build cannot make.
        delivery-note: string,
        /// Member refs (`MemberRef` display strings, M05A A5e)
        /// `revoke-instance` has excluded from every write path. Otherwise
        /// invisible on this read surface until something else triggers a
        /// write pass that reaches the member and raises `InstanceRevoked`
        /// -- a state this permanent should not depend on that.
        revoked-placements: list<string>,
        /// The app instance's own master DID (M05A A7, ADR-0022 §1),
        /// minted or resolved at `adopt`. Absent means "never adopted
        /// under A7" -- a genuinely different fact from "adopted", the
        /// same option-not-sentinel choice `last-reconciled-at` already
        /// makes. Read from the stored row only, never the vault, so it
        /// stays reportable while the vault is locked.
        app-master-did: option<string>,
    }

    record alert {
        /// The member's `MemberRef` display string (M05A A5e), or absent
        /// for a substrate-level alert that belongs to no one member.
        logical-ref: option<string>,
        substrate-did: string,
        kind: string,
        detail: string,
        first-seen-at: s64,
        last-seen-at: s64,
        cleared-at: option<s64>,
    }

    submit:          func(s: submission)          -> result<submit-result, string>;

    /// `adopt`'s result: the claimed generation, plus the app instance's
    /// own master (M05A A7) -- an operator who has just caused this key to
    /// exist is told its backup command in the same call, the same rule
    /// `submit-result`'s `minted-master` rows already encode.
    record adopt-result {
        generation: u64,
        app-master-did: string,
        /// The name `export-master`/`import-master` take for this app
        /// instance's own master -- `app-<app-instance-id>`.
        vault-name: string,
    }

    /// Mints the next generation: reads what the substrates report
    /// holding and writes `held + 1`. The only minter. Also resolves or
    /// mints this app instance's own master (M05A A7, D-A7-1/D-A7-5) --
    /// on *every* call, not only the first, so `adopt` after
    /// `import-master` always agrees with whatever the vault now holds
    /// rather than minting a second identity. Refuses outright, claiming
    /// no generation, if the vault is locked.
    adopt:           func(app-instance-id: string) -> result<adopt-result, string>;
    /// Hand the instance back to manual operation: clears the stamp on
    /// every substrate it is placed on. Does **not** undeploy.
    release:         func(app-instance-id: string) -> result<_, string>;
    /// Stops the resident loop from touching this instance automatically
    /// -- nothing else. Every other verb (`submit`/`force-reconcile`/
    /// `adopt`/`release`/`retire`) stays allowed while paused; pausing
    /// automation to act by hand is the ordinary reason to pause (M05A
    /// A5c D-A5c-14). Takes effect at the start of the loop's next
    /// *write* phase, not mid-pass -- a pause landing during a pass's
    /// health sweep does not abort writes already in flight for that
    /// same pass.
    pause:           func(app-instance-id: string) -> result<_, string>;
    %resume:         func(app-instance-id: string) -> result<_, string>;
    /// Stop managing and release. Deliberately not a teardown: retiring a
    /// running app must not destroy it.
    retire:          func(app-instance-id: string) -> result<_, string>;
    force-reconcile: func(app-instance-id: string) -> result<_, string>;
    /// Write `name`'s master out of the vault into the operator-declared
    /// `master_backup_dir`, and return **only the path written**. Backup
    /// is mandatory, and mint-in-place means the operator holds nothing
    /// until they ask.
    ///
    /// No key bytes in the response, and no caller-supplied path: the
    /// argument is a *name*, so a caller cannot steer a private key
    /// anywhere. The operator collects the file from the host by whatever
    /// means they already use -- which an offline `roymctl` cannot
    /// replace, because the vault is encrypted and its KEK lives only in
    /// this process's memory.
    export-master: func(name: string) -> result<string, string>;
    /// Adopt a master already placed into `master_backup_dir` into the
    /// vault -- either a member master an operator already created (an
    /// A0-A4 deployment's `<dir>/identities/member-*.key`), or an app
    /// instance's own master (M05A A7) carried over from another
    /// supervisor by a prior `export-master`. Reads by name from that same
    /// directory; takes no key material and no path. For an app master, a
    /// handover's intended order is `import-master` before `adopt`:
    /// adopting first mints a second app identity under the same name,
    /// which a later `import-master`/`adopt` repairs but does not prevent
    /// (D-A7-5).
    import-master: func(name: string) -> result<_, string>;

    /// Revoke one placed member's derived instance key. Two writes in one
    /// operator action, because either alone is not a revocation:
    ///
    /// 1. the member master's anchor gains the derived instance DID in its
    ///    `revoked-keys` list, so every handshake presenting that key fails
    ///    from then on; and
    /// 2. the placement is recorded revoked here, so nothing mints it a
    ///    fresh certificate afterwards -- not the resident loop's renewal,
    ///    not `submit`, not `force-reconcile`. Without this half, the very
    ///    next ordinary redeploy would silently reinstate the key.
    ///
    /// Scoped to one member, not the whole instance: the rest keeps
    /// reconciling. Deliberately not a teardown either -- the process keeps
    /// running until an operator issues `undeploy`/`retire` separately.
    ///
    /// `logical-ref` is the member's full `MemberRef` display string, as
    /// `status` reports it (`<app-instance-id>/<service-name>#<index>`,
    /// M05A A5e) -- with two members of one scaled service, the bare
    /// `<app-instance-id>/<service-name>` no longer names one of them.
    revoke-instance: func(app-instance-id: string, logical-ref: string) -> result<_, string>;

    status:  func(app-instance-id: string)            -> result<instance-status, string>;
    alerts:  func(app-instance-id: string, all: bool) -> result<list<alert>, string>;
}

world supervisor-service {
    export supervisor;
}

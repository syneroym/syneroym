package syneroym:control-plane;

interface orchestrator {
    /// Represents where a deployment artifact can be fetched from.
    variant artifact-source {
        /// A URL pointing to the artifact (e.g., OCI registry, HTTPS URL).
        url(string),
        /// The raw binary bytes of the artifact itself.
        binary(list<u8>),
    }

    /// Where a deploy-time text document (a JSON Schema, an FDAE policy, a
    /// container's config file) comes from. Inline is what lets a client
    /// deploy with nothing pre-staged on the substrate host; path is for
    /// large or shared assets and operator-managed directories.
    variant document-source {
        /// A path on the substrate host's own filesystem, resolved relative
        /// to its working directory and guarded against traversal.
        path(string),
        /// The document's content, carried in the deploy call itself.
        inline(string),
    }

    record resource-quota {
        max-instructions: option<u64>,
        max-memory-bytes: option<u64>,
    }

    variant rotation-policy {
        restart-on-rotation,
        none,
    }

    record tcp-probe {
        interface-name: string,
        timeout-ms: u32,
    }

    record http-probe {
        interface-name: string,
        path: string,
        expect-status: u16,
        timeout-ms: u32,
    }

    record rpc-probe {
        interface-name: string,
        method: string,
        timeout-ms: u32,
    }

    /// Author-declared readiness probe, run by the *substrate* on behalf of a
    /// supervisor: a container's port is host-local and a wasm probe needs
    /// the sandbox engine, so neither is reachable from a remote poller.
    /// Absent leaves the service liveness-only -- and for a `tcp` service,
    /// which runs outside the substrate, absent leaves it with no liveness
    /// signal at all.
    variant health-check {
        tcp-connect(tcp-probe),
        http-get(http-probe),
        rpc(rpc-probe),
    }

    /// General configuration provided to the deployed service.
    record service-config {
        /// Environment variables represented as key-value pairs.
        env: list<tuple<string, string>>,
        /// Command-line arguments.
        args: list<string>,
        /// Arbitrary nested configuration (e.g., serialized JSON).
        custom-config: option<string>,
        quota: option<resource-quota>,
        /// JSON Schema validating `custom-config`, applied at deploy.
        schema: option<document-source>,
        rotation-policy: option<rotation-policy>,
        /// This service's declarative FDAE ReBAC policy document (ADR-0017
        /// §1), read and validated at deploy. Absent = no row/column
        /// filtering for this service.
        fdae-policy: option<document-source>,
        /// Author-declared readiness probe (M05A A4). Absent = liveness only.
        health-check: option<health-check>,
    }

    /// Manifest details for a Wasm component deployment.
    record wasm-manifest {
        source: artifact-source,
        hash: option<string>,
        interfaces: list<string>,
    }

    /// Port mapping for container
    record container-port-mapping {
        interface-name: string,
        host-port: option<u16>,
        container-port: u16,
        protocol: string,
    }

    /// A file materialized inside a container volume before the container
    /// starts, for images that read configuration from a mounted file rather
    /// than environment variables.
    record container-volume-file {
        /// Path relative to the volume root. Must not escape it.
        relative-path: string,
        content: document-source,
    }

    /// Volume mapping for container
    record container-volume-mapping {
        host-path: string,
        container-path: string,
        /// When non-empty, these files are written into the volume and the
        /// mount is read-only. Empty leaves an empty writable directory.
        files: list<container-volume-file>,
    }

    /// Manifest details for a container (Podman) deployment.
    record container-manifest {
        source: artifact-source,
        hash: option<string>,
        image: string,
        ports: list<container-port-mapping>,
        volumes: list<container-volume-mapping>,
    }

    /// Endpoint configuration for network services
    record network-endpoint {
        interface-name: string,
        host: string,
        port: u16,
    }

    /// Manifest details for an existing TCP service.
    record tcp-manifest {
        endpoints: list<network-endpoint>,
    }

    /// Defines the specific type of service and carries its specific payload.
    variant service-type {
        wasm(wasm-manifest),
        container(container-manifest),
        tcp(tcp-manifest),
    }

    /// A comprehensive manifest for deploying a service on the substrate.
    record deploy-manifest {
        /// Base configuration applied to the service
        config: service-config,
        /// Type and specific configurations for the service
        service-type: service-type,
        /// Optional serialized SignedEndpointInfo to proxy registration to the community registry
        registry-certificate: option<string>,
        /// JSON DelegationCertificate binding this substrate's derived instance
        /// key to the member master that `service-id` names. Verified on
        /// receipt; absent leaves the service its own master (ADR-0020 §1
        /// fallback).
        instance-certificate: option<string>,
    }

    record deployed-service {
        service-id: string,
        interfaces: list<string>,
        endpoint-type: string,
        /// Unix seconds when the installed instance certificate expires, if
        /// one is installed.
        instance-certificate-expires-at: option<u64>,
    }

    /// The instance signing key this substrate derives for `service-id` under
    /// the calling identity. Deterministic and answerable before the service
    /// is deployed, which is what lets the master holder certify the key
    /// without the substrate ever holding the master.
    record instance-identity {
        /// did:key of the derived instance key.
        instance-did: string,
        /// Hex-encoded ed25519 public key -- the form a route preamble carries.
        pubkey-hex: string,
    }

    /// Query the instance signing key this substrate would derive for
    /// `service-id` under the calling identity, without deploying anything.
    resolve-instance-identity: func(service-id: string) -> result<instance-identity, string>;

    /// Deploy a new service using a deployment manifest
    deploy: func(service-id: string, manifest: deploy-manifest) -> result<_, string>;

    /// Undeploy a service, stopping it and cleaning up resources
    undeploy: func(service-id: string) -> result<_, string>;

    /// An app instance's management stamp, or `none` if no deploy has
    /// ever named it here. `adopt`'s read half (M05A A5): a supervisor
    /// must be able to learn the held generation before it can mint the
    /// next one, and no service-level record carries it.
    record app-instance-management {
        owner-did: string,
        supervisor-did: option<string>,
        generation: u64,
    }
    app-instance-management-of: func(app-instance-id: string)
        -> result<option<app-instance-management>, string>;

    /// Claim management of an app instance at `generation` -- ADR-0021
    /// §4's operator-minted adopt, made durable at the moment of the
    /// claim rather than on whatever write happens next. Subject to the
    /// same four-case rule as every other write, so two supervisors
    /// racing an adopt lose deterministically here instead of both
    /// believing they won until one issues a deploy.
    claim-app-instance: func(app-instance-id: string, generation: u64)
        -> result<_, string>;

    /// Clear an app instance's management stamp: `supervisor-did` back to
    /// none and `generation` back to 0, keeping the owner. Called by the
    /// supervisor on retire/release. Without it, an adopted instance can
    /// never be hand-deployed again -- a plain `app deploy` presents 0
    /// against a held generation and is refused forever, with no verb
    /// able to undo it.
    release-app-instance: func(app-instance-id: string, generation: u64)
        -> result<_, string>;

    /// List currently deployed services
    %list: func() -> result<list<deployed-service>, string>;

    /// Check the readiness of the orchestrator
    readyz: func(service-id: string) -> result<_, string>;

    /// How a logical service name maps to physical members. Mirrors
    /// `TopologyMode` in the app model.
    variant topology-mode {
        singleton,
        redundant,
        sharded,
    }

    /// One declared dependency of the service being deployed, resolved to
    /// the member master DIDs that currently serve it. The dependent's
    /// host resolves a guest-supplied dependency name through this;
    /// nothing else in the substrate reads it.
    record dependency-binding {
        /// The name the depending service declared. Today always a
        /// logical service name inside `app-instance-id`.
        dependency-name: string,
        /// The app instance the members live in. Equal to the dependent's
        /// own `app-instance-id` today; a distinct value once a manifest
        /// can express a cross-app bind.
        app-instance-id: string,
        mode: topology-mode,
        /// Member master DIDs, in selection order.
        members: list<string>,
        /// Increments on any membership or mode change; the epoch guard
        /// that reads it is the supervisor's.
        epoch: u64,
        cache-ttl-ms: u64,
    }

    /// Which app instance this service is being deployed as part of, and
    /// what its declared dependencies currently resolve to. Absent for a
    /// standalone deploy that participates in no app.
    record app-context {
        app-instance-id: string,
        service-name: string,
        bindings: list<dependency-binding>,
        /// The generation the writer manages this app instance at
        /// (ADR-0021 §4). `0` means "unmanaged", which is what every
        /// operator-driven `roymctl app deploy` sends and what an
        /// un-adopted instance accepts. A supervisor sends the
        /// generation its `adopt` minted -- without this field it would
        /// present 0 and be locked out of its own app on the first
        /// reconcile after an adopt.
        generation: u64,
    }

    /// A planned service in a deployment plan.
    record planned-service {
        service-id: string,
        logical-ref: string,
        manifest: deploy-manifest,
        /// This service's app instance and dependency bindings (ADR-0021
        /// §2). Absent leaves the service unable to resolve a declared
        /// dependency name -- it can still be called, and can still call
        /// out by DID.
        app-context: option<app-context>,
    }

    /// A deployment plan containing multiple planned services.
    record deployment-plan {
        app-instance-id: string,
        blueprint-id: string,
        version: string,
        services: list<planned-service>,
    }

    /// Deploy an entire compiled deployment plan
    deploy-plan: func(plan: deployment-plan) -> result<_, string>;

    /// Whether the substrate believes this service's instance is running.
    /// Deliberately not a bool: the supervisor's remediation differs per
    /// variant, and `unknown` must never be silently read as healthy.
    variant instance-phase {
        /// A wasm component is loaded, or the container reports Running.
        running,
        /// Deployed here, but the instance is down. Carries the reason.
        not-running(string),
        /// The substrate cannot know -- a `tcp` service runs outside it, or
        /// no service type was recorded (deployed by a pre-A4 binary).
        /// Carries which. A declared probe still runs in this state.
        unknown(string),
        /// This substrate has no endpoints registered for the id at all.
        /// Distinct from `not-running`: a deploy that never landed, versus a
        /// deploy that landed and stopped. Also what a caller without a
        /// grant on the id gets back for an explicitly named id it may not
        /// see (A4-10): indistinguishable from an id that was never
        /// deployed at all, deliberately, so a caller with no grant on an
        /// id cannot use this to probe for its existence.
        not-found,
    }

    variant probe-status {
        /// The service declared none; liveness only.
        not-declared,
        passing,
        failing(string),
    }

    record service-status {
        service-id: string,
        /// What the deploy said this service is: "wasm" / "container" /
        /// "tcp". Absent for a service deployed before this was recorded.
        /// Distinct from `endpoint-type`, which reports the *endpoint*
        /// variant and cannot tell a container from a TCP service.
        service-type: option<string>,
        endpoint-type: string,
        /// From the deploy's `app-context`, when it had one (A2).
        app-instance-id: option<string>,
        service-name: option<string>,
        phase: instance-phase,
        probe: probe-status,
        /// Both halves of the installed instance certificate's lifetime, so
        /// a reader can apply the same relative near-expiry rule the
        /// substrate's own heartbeat sweep uses (ADR-0020 §3) rather than
        /// inventing an absolute window.
        instance-certificate-issued-at: option<u64>,
        instance-certificate-expires-at: option<u64>,
        /// Unix seconds the probe result was produced. Earlier than
        /// `checked-at` when a cached result was served.
        probe-checked-at: option<u64>,
    }

    /// What this node is, as opposed to what is running on it. Answers two
    /// questions a deploying client could previously only guess at: what
    /// service types it can actually run, and which registry namespace it
    /// publishes endpoint records into.
    record node-facts {
        node-did: string,
        /// "wasm" / "container" / "tcp", per compiled-in sandbox features.
        service-types: list<string>,
        registry-url: option<string>,
        dht-enabled: bool,
    }

    record substrate-status {
        /// Present only for a caller holding node-wide `orchestrator/status`.
        /// An app-scoped caller still gets `services` for its own services;
        /// what a node can run and where it publishes is not theirs to read.
        node: option<node-facts>,
        checked-at: u64,
        services: list<service-status>,
    }

    /// Per-instance status for a supervisor's poll loop. An empty
    /// `service-ids` means "every service this caller may see", using the
    /// same visibility rule as `list`. A named id the caller may not see
    /// comes back `not-found` (A4-10) -- identical to an id never deployed
    /// at all, deliberately, so a caller with no grant on an id cannot use
    /// this to probe for its existence.
    status: func(service-ids: list<string>) -> result<substrate-status, string>;
    /// `status`'s `node` field alone (A4-06), with none of `status`'s
    /// per-service work -- for a caller that wants only what this node is,
    /// not what is running on it (e.g. `app deploy`'s preflight). `none` for
    /// a caller without node-wide `orchestrator/status`, the same as
    /// `status`'s own `node` field.
    node-facts-only: func() -> option<node-facts>;
}

interface health {
    /// Ping the service to check its health
    ping: func() -> result<string, string>;
}

interface security {
    inject-kek: func(kek-hex: string) -> result<_, string>;
    rotate-kek: func(new-kek-hex: string) -> result<_, string>;
    set-secret: func(service-id: string, key: string, value: list<u8>) -> result<_, string>;
}

world control-plane-service {
    export orchestrator;
    export health;
    export security;
}

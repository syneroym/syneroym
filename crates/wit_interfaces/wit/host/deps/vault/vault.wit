package syneroym:vault@0.1.0;

interface vault {
    variant vault-error {
        not-found,
        permission-denied,
        internal(string),
    }

    /// Names that start with `syneroym.` are reserved for the substrate.
    /// `reveal` always answers `not-found` for them, even when the entry
    /// exists. Guest SQL cannot read or change the vault table, and an
    /// entry cannot be copied to another name: the name is part of what
    /// the entry is encrypted with.
    reveal: func(key: string) -> result<list<u8>, vault-error>;
}

world vault-guest {
    import vault;
}

package syneroym-test:proxy-test@0.1.0;

interface test-driver {
    /// Originates a Universal Proxy call (M04A Slice A1) at
    /// `syneroym:proxy/proxy::call` and returns the raw result string, or the
    /// `proxy-error` debug-formatted as a string on failure -- sufficient for
    /// integration tests to assert on without needing a typed WIT variant on
    /// this side too.
    /// `target-kind` selects which `call-target` variant `service` becomes:
    /// `"service"` (a raw DID/alias) or `"dependency"` (a declared
    /// dependency name, resolved host-side) -- one fixture driving both A2
    /// variants.
    call-peer: func(
        service: string,
        %interface: string,
        method: string,
        params: string,
        target-kind: string,
    ) -> result<string, string>;

    /// Hands a call to this service's durable outbox at
    /// `syneroym:proxy/proxy::enqueue`, returning the `proxy-error`
    /// debug-formatted on failure. `idempotency-key` is passed through
    /// verbatim, including empty -- an empty string is sent as *absent*, so
    /// a test can drive the no-key refusal through the real guest boundary
    /// rather than against a Rust-level fake.
    enqueue-peer: func(
        service: string,
        %interface: string,
        method: string,
        params: string,
        target-kind: string,
        idempotency-key: string,
    ) -> result<_, string>;
}

world proxy-test {
    import syneroym:proxy/proxy@0.1.0;
    export test-driver;

    /// Stage-4 ABAC after-step (ADR-0017 §7): exported so this component can
    /// also serve as the self-proxy target in
    /// `crates/router/tests/proxy_dispatch.rs`'s
    /// `guest_self_proxy_data_layer_applies_stage4` -- a guest calling its
    /// own `data-layer` through `syneroym:proxy/proxy::call` (ingress ii)
    /// under a stage-4-opted policy. Denies the row seeded with id
    /// `"secret"`, allows everything else; see `src/lib.rs`.
    export syneroym:data-layer/authorizer@0.1.0;
}

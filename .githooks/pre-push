#!/bin/sh

# Add cargo to PATH for GUI clients
export PATH="$HOME/.cargo/bin:$PATH"

echo "Running pre-push checks..."

# Ensure formatting is correct (double check)
echo "Checking cargo fmt..."
if ! cargo fmt --all -- --check; then
    echo "❌ cargo fmt failed! Please format your code before pushing."
    exit 1
fi

# Run clippy to catch common mistakes before code leaves the machine
echo "Checking cargo clippy..."
if ! cargo clippy --workspace --all-targets --all-features -- -D warnings; then
    echo "❌ cargo clippy failed! Please fix the warnings before pushing."
    exit 1
fi

# Check licenses if cargo-deny is installed
if command -v cargo-deny >/dev/null 2>&1; then
    echo "Checking cargo deny licenses..."
    if ! cargo deny check licenses; then
        echo "❌ cargo deny check licenses failed! Please resolve license issues before pushing."
        exit 1
    fi
fi

# Check security audit if cargo-audit is installed
if command -v cargo-audit >/dev/null 2>&1; then
    echo "Checking cargo audit..."
    if ! cargo audit; then
        echo "❌ cargo audit failed! Please resolve security advisories before pushing."
        exit 1
    fi
fi

echo "✅ All pre-push checks passed! Pushing code..."
exit 0

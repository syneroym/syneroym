# Syneroym demo environment.
#
#   cp docs/demo/demo.env.example ~/syneroym-demo.env
#   $EDITOR ~/syneroym-demo.env        # set CLOUD_IP, nothing else is required
#   source ~/syneroym-demo.env         # in EVERY terminal on the Mac
#
# Works in zsh and bash. Edit values here, never inside the runbook commands.

# ---- Where things are ------------------------------------------------------
export REPO="$HOME/gitSyneroym/syneroym"
export DEMO_HOME="$HOME/syneroym-demo"          # all demo state lives here
export BIN="$REPO/target/release"               # use target/debug if you built debug
export PATH="$BIN:$PATH"

# ---- The cloud machine (coordinator + relay + registry) ---------------------
export CLOUD_IP="CHANGE-ME"                     # public IP of the cloud machine
export REGISTRY="http://$CLOUD_IP:7961"
export CLOUD_DOMAIN="$CLOUD_IP.nip.io"          # a host name that resolves to the cloud IP
                                                # (needs internet DNS; see runbook 1.1)

# ---- The two substrates on the Mac ------------------------------------------
export S1_DIR="$DEMO_HOME/s1"                   # "alice-node"
export S2_DIR="$DEMO_HOME/s2"                   # "bob-node"
export S1_GW=7970                               # client gateway ports (HTTP)
export S2_GW=7980
export S1_HEALTH=7976                           # S1 health / metrics (runbook F13)
export S1_METRICS=7977

# 32-byte key-encryption key, as 64 hex characters. Demo value only.
export KEK="2121212121212121212121212121212121212121212121212121212121212121"

# ---- Pre-built WASM components ----------------------------------------------
export GREETER_WASM="$REPO/test-components/greeter/target/wasm32-wasip2/release/syneroym_test_greeter.wasm"
export MINIAPP_DIR="$REPO/test-components/miniapp-demo1-wasm"
export MINIAPP_WASM="$MINIAPP_DIR/target/wasm32-wasip2/release/syneroym_test_miniapp_demo1_wasm.wasm"
export SCHED_WASM="$REPO/test-components/scheduled-test/target/wasm32-wasip2/release/syneroym_test_scheduled.wasm"
export SAGA_WASM="$REPO/test-components/saga-test/target/wasm32-wasip2/release/syneroym_test_saga.wasm"

# ---- Interface names used in the demo ---------------------------------------
export GREETER_IFACE="syneroym-test:greeter/greet@0.1.0"
export SCHED_IFACE="syneroym-test:scheduled-test/scheduled-driver@0.1.0"

# ---- Helpers ----------------------------------------------------------------
# DIDs are read from the substrate logs once the nodes are running.
demo_dids() {
  S1_DID=$(grep -m1 'substrate identity initialized' "$S1_DIR/substrate.log" | grep -oE 'did:key:[a-z0-9]+' | head -1)
  S2_DID=$(grep -m1 'substrate identity initialized' "$S2_DIR/substrate.log" | grep -oE 'did:key:[a-z0-9]+' | head -1)
  export S1_DID S2_DID
  echo "S1_DID=$S1_DID"
  echo "S2_DID=$S2_DID"
}

# "Run roymctl against substrate 1 / 2, as its owner."
rc1() { roymctl --dir "$S1_DIR" --api-url "$REGISTRY" --substrate "$S1_DID" --as owner "$@"; }
rc2() { roymctl --dir "$S2_DIR" --api-url "$REGISTRY" --substrate "$S2_DID" --as owner "$@"; }

# Print the DID of a locally stored identity.  usage: did_of <dir> <name>
did_of() { roymctl --dir "$1" identity show --name "$2" | grep -oE 'did:key:[a-z0-9]+' | head -1; }

# Print the gateway host name for a service.  usage: host_of <did> [alias flags...]
host_of() { roymctl alias "$@" | tail -1; }

# JSON-RPC call through a gateway.  usage: rpc <gateway-port> <host> <method> '<json params>'
rpc() {
  curl -s -X POST "http://127.0.0.1:$1/" -H "Host: $2" -H 'Content-Type: application/json' \
    -d "{\"jsonrpc\":\"2.0\",\"method\":\"$3\",\"params\":${4:-[]},\"id\":1}"
  echo
}
